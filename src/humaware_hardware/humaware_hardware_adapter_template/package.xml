<?xml version="1.0"?>
<package format="3">
  <name>humaware_hardware_adapter_template</name>
  <version>0.1.0</version>
  <description>
    Template package for HumaWare hardware adapters. Adapter authors should
    copy this package, rename it, and implement vendor-specific command
    translation while preserving the runtime safety contract documented in
    README.md.
  </description>
  <maintainer email="maintainers@humaware.dev">HumaWare Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>humaware_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
